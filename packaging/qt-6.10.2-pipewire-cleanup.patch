--- a/src/multimedia/pipewire/qpipewire_screencapturehelper.cpp
+++ b/src/multimedia/pipewire/qpipewire_screencapturehelper.cpp
@@ -779,7 +779,8 @@ void QPipeWireCaptureHelper::destroy()
     m_state = Stopping;
     destroyStream(false);
 
-    pw_thread_loop_stop(m_threadLoop.get());
+    if (m_threadLoop)
+        pw_thread_loop_stop(m_threadLoop.get());
 
     m_registry = {};
     m_core = {};
